@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-danger">
                <div class="card-body text-center p-5">
                    <div class="text-danger mb-4">
                        <i class="bi bi-shield-x" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="display-4 text-danger mb-3">Access Denied</h1>
                    <p class="lead text-muted mb-4">
                        You do not have permission to access this resource.
                    </p>
                    <hr class="my-4">
                    <p class="text-muted">
                        If you believe this is an error, please contact your system administrator.
                    </p>
                    <div class="mt-4">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary me-2">
                            <i class="bi bi-house-door me-2"></i>Go to Home
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

